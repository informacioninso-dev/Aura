[Unit]
Description=Aura Django API (Gunicorn)
After=network.target postgresql.service redis-server.service

[Service]
Type=simple
User=aura
Group=www-data
WorkingDirectory=/var/www/aura/back
EnvironmentFile=/var/www/aura/back/.env
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0027
ExecStart=/var/www/aura/back/.venv/bin/gunicorn config.wsgi:application \
    --bind 127.0.0.1:8000 \
    --workers 2 \
    --worker-class gthread \
    --threads 4 \
    --timeout 120 \
    --graceful-timeout 30 \
    --keep-alive 5 \
    --max-requests 1000 \
    --max-requests-jitter 100 \
    --access-logfile - \
    --error-logfile -
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
ReadWritePaths=/var/www/aura/back/media

[Install]
WantedBy=multi-user.target
